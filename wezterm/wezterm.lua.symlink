-- Wezterm config documentation: https://wezterm.org/config/files.html

---@type Wezterm
local wezterm = require('wezterm')

---@type Config
local config = wezterm.config_builder()

local font = 'Iosevka Nerd Font Mono'

config.font = wezterm.font(font)
config.font_size = 14

-- SET COLOSCHEME

local function scheme_for_appearance(appearance)
  if appearance:find('Dark') then
    return require('cyberdream')
  else
    return require('cyberdream-light')
  end
end

local colorscheme = scheme_for_appearance(wezterm.gui.get_appearance())

config.window_frame = colorscheme.window_frame
config.window_frame.font = wezterm.font { family = font, weight = 'Bold' }

config.colors = colorscheme.colors

config.window_background_opacity = 0.85
config.macos_window_background_blur = 30

-- Make Option key behave like Alt/Meta instead of typing special characters
config.send_composed_key_when_left_alt_is_pressed = false
config.send_composed_key_when_right_alt_is_pressed = false

return config
